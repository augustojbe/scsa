# =============================================================================
# SCSI - Exemplo de configuração de ambiente (gitignored)
# Copie para .env (desenvolvimento) ou .env.production (produção) e preencha.
# NUNCA versione valores reais.
# =============================================================================

# --- Geral ---
DEBUG=True
SECRET_KEY=django-insecure-change-me
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
TIME_ZONE=America/Sao_Paulo
LANGUAGE_CODE=pt-br

# --- Banco / Cache / Broker ---
# Desenvolvimento (sqlite):
DATABASE_URL=sqlite:///db.sqlite3
# Produção (PostgreSQL):
# DATABASE_URL=postgres://scsi:<SENHA>@db:5432/scsi
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=amqp://localhost:5672//

# --- Email ---
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=no-reply@scsi.digital

# --- Segurança (produção) ---
# DEBUG=False
# SECURE_SSL_REDIRECT=True
# ALLOWED_HOSTS=scsi.digital,.scsi.digital,localhost,127.0.0.1
# CSRF_TRUSTED_ORIGINS=https://scsi.digital,https://*.scsi.digital

# --- IA (opcional) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5-mini
